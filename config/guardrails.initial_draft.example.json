{
  "schema_version": "aicr-guardrails-v1",
  "external_actions_default": "dry-run",
  "initial_draft_auto_enabled": true,
  "initial_draft_chatwork_send_enabled": true,
  "revision_auto_generation_enabled": false,
  "chatwork_feedback_auto_regenerate_enabled": false,
  "image2_generation_enabled": true,
  "drive_upload_enabled": false,
  "chatwork_send_enabled": true,
  "sheet_write_enabled": false,
  "require_human_review_before_chatwork_send": false,
  "require_human_review_before_sheet_write": true,
  "image2_api": {
    "model": "gpt-image-2",
    "size": "1088x1088",
    "final_size": "1080x1080",
    "quality": "medium",
    "output_format": "png",
    "moderation": "auto"
  },
  "creative_prompt_json": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "max_output_tokens": 5000
  },
  "client_master": {
    "enabled": false,
    "config_path": "config/client_master.example.json",
    "read_mode": "public-csv-or-google-sheets"
  },
  "brand_assets": {
    "logo_insertion_enabled": false,
    "required_note_band_enabled": false,
    "brand_color_prompt_enabled": false,
    "logo_avoid_note_band_enabled": true,
    "bottom_safe_area_prompt_enabled": true,
    "default_logo_placement": "bottom_right",
    "logo_overlay": {
      "max_width_ratio": 0.18,
      "max_height_ratio": 0.1,
      "margin": 32
    },
    "note_band": {
      "use_brand_color_as_background": true,
      "background_color": "#111111",
      "text_color": "",
      "font_family": "Hiragino Sans, Yu Gothic, Noto Sans CJK JP, sans-serif",
      "font_weight": "700",
      "font_size": 26,
      "min_font_size": 18,
      "line_height": 1.35,
      "min_height": 72,
      "max_height": 320,
      "horizontal_padding": 40,
      "vertical_padding": 18
    }
  },
  "text_quality_gate": {
    "enabled": false,
    "model": "gpt-4o-mini",
    "max_retries": 2,
    "max_output_tokens": 600
  },
  "initial_draft": {
    "max_requests_per_run": 1,
    "image_generation_concurrency": 2,
    "chatwork_room_id": "442334168",
    "to_all": false,
    "mention_sheet_name": "API通知",
    "sheet_write_after_post": false,
    "drive_upload_after_generation": false
  },
  "policy": {
    "ng_expressions": [
      "絶対痩せる",
      "必ず生える",
      "効果保証",
      "副作用なし",
      "リスクなし"
    ],
    "medical_beauty_terms": [
      "医療",
      "治療",
      "クリニック",
      "AGA",
      "薄毛",
      "脱毛",
      "痩身",
      "脂肪",
      "シミ",
      "しわ",
      "二重",
      "美容外科"
    ],
    "ba_risk_terms": [
      "Before/After",
      "before after",
      "ビフォーアフター",
      "施術前",
      "施術後",
      "比較写真"
    ],
    "exaggeration_terms": [
      "絶対",
      "必ず",
      "確実",
      "100%",
      "完全",
      "永久",
      "保証",
      "No.1",
      "日本一",
      "最安",
